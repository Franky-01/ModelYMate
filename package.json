{
  "name": "modelymate-pwa",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5178",
    "build": "pnpm run build:frontend",
    "start": "node server/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "build:frontend": "node tools/prepare-pwa.mjs && tsc --noEmit && vite build"
  },
  "dependencies": {
    "coordtransform": "2.1.2",
    "lucide-react": "0.468.0",
    "next": "16.3.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "react-server-dom-webpack": "19.2.6",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  },
  "license": "MIT",
  "description": "Personal TeslaMate dashboard with seven articulated vehicle displays and local-first PWA workflows. Vehicle assets: CC BY 4.0 and CC BY-NC 4.0."
}
